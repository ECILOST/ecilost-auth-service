# Plantilla del entorno de las pruebas e2e. Copiala a .env.test, que no se versiona:
#
#   cp .env.test.example .env.test
#
# Luego genera el par RS256 con el comando que hay mas abajo y pega las dos lineas.
# Sin este archivo, `npm run test:e2e` no arranca. Las unitarias no lo necesitan.
#
# Requiere PostgreSQL levantado:  docker compose up -d

NODE_ENV=test

# Mismo contenedor que desarrollo, pero esquema aparte: las pruebas borran tablas
# entre casos y no deben tocar los datos con los que estas trabajando.
DATABASE_URL=postgresql://ecilost:ecilost@localhost:5433/ecilost_auth?schema=auth_test

# El cliente de Google va sustituido por un doble en las pruebas, asi que estas
# credenciales nunca salen a la red. No pongas aqui las reales.
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Hay una prueba que comprueba que este correo recibe rol STAFF.
STAFF_EMAILS=funcionario@escuelaing.edu.co

JWT_ISSUER=https://auth.ecilost.test
JWT_AUDIENCE=ecilost-services
# Una prueba afirma que expires_in vale 900. Si cambias este valor, actualizala.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Par RS256 en base64, desechable y solo para pruebas. Generalo con:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('JWT_PRIVATE_KEY='+Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('JWT_PUBLIC_KEY='+Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

COOKIE_SECRET=secreto-de-prueba-para-firmar-cookies
COOKIE_SECURE=false

POST_LOGIN_REDIRECT_URL=http://localhost:5173/rooms
POST_LOGIN_ERROR_URL=http://localhost:5173/login
