# Copia este archivo a .env y rellena los valores. .env NO se versiona.

NODE_ENV=development
PORT=3000

# El parametro ?schema= aisla este servicio: un esquema por microservicio, sin joins cruzados.
# El puerto 5433 es el que expone docker-compose.yml (5432 suele estar tomado en local).
DATABASE_URL="postgresql://ecilost:ecilost@localhost:5433/ecilost_auth?schema=auth"

# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth 2.0
# (tipo "Aplicacion web"). El redirect URI debe estar autorizado ahi, identico a esta linea.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Politica de acceso: entra cualquier cuenta de Google con el correo verificado.
# Los correos de STAFF_EMAILS reciben rol STAFF al darse de alta; el resto entra como STUDENT.
STAFF_EMAILS=

# Emisor del access token propio. Los demas servicios validan iss y aud con estos valores.
JWT_ISSUER=https://auth.ecilost.local
JWT_AUDIENCE=ecilost-services
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Par RS256 en base64 (un PEM crudo es multilinea y no sobrevive a un archivo .env).
# Genera uno nuevo con:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('JWT_PRIVATE_KEY='+Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('JWT_PUBLIC_KEY='+Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Firma las cookies oauth_tx y ecilost_rt. Usa al menos 32 bytes aleatorios en produccion.
COOKIE_SECRET=
# Ponlo en true en cuanto haya HTTPS.
COOKIE_SECURE=false

# A donde vuelve el navegador tras el callback. El listado de salas es del frontend y de
# auction-core (Sprint 3); este servicio solo redirige. 5173 es el puerto por defecto de Vite.
POST_LOGIN_REDIRECT_URL=http://localhost:5173/rooms
POST_LOGIN_ERROR_URL=http://localhost:5173/login

# Broker local para eventos de integracion. En produccion se reemplaza por el endpoint seguro.
RABBITMQ_URL=amqp://ecilost:ecilost@localhost:5672
